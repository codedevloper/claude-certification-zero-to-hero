{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/claude-certification-zero-to-hero/schema/question-bank.schema.json",
  "title": "Unofficial practice question bank",
  "description": "One file per certification domain. All questions are independently authored and unofficial.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track", "domain", "unofficial", "questions"],
  "properties": {
    "schema_version": {"const": 1},
    "track": {"type": "string", "pattern": "^[A-Z]{4}-[A-Z]$"},
    "domain": {"type": "integer", "minimum": 1},
    "unofficial": {"const": true},
    "notice": {"type": "string"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/question"}
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "objective", "type", "difficulty", "category", "scenario", "question",
        "options", "answer", "explanation", "why_incorrect", "module", "references"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{4}-[A-Z]-D[0-9]-[0-9]{3}$", "description": "TRACK-D<domain>-<nnn>, e.g. CCAO-F-D2-004"},
        "objective": {"type": "string", "pattern": "^[A-Z]{4}-[A-Z]-[0-9]+\\.[0-9]+$", "description": "Objective ID from 16-certification-tracks/registry.yaml"},
        "type": {"enum": ["single", "multiple"]},
        "select": {"type": "integer", "minimum": 2, "description": "Required for type=multiple: how many options to choose"},
        "difficulty": {"enum": ["foundation", "intermediate", "advanced"]},
        "category": {"enum": ["concept", "scenario", "architecture", "troubleshooting", "security", "cost-performance"]},
        "scenario": {"type": "string", "minLength": 20},
        "question": {"type": "string", "minLength": 10},
        "options": {
          "type": "object",
          "minProperties": 4,
          "maxProperties": 6,
          "propertyNames": {"pattern": "^[A-F]$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "answer": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-F]$"}, "uniqueItems": true},
        "explanation": {"type": "string", "minLength": 40},
        "why_incorrect": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-F]$"},
          "additionalProperties": {"type": "string", "minLength": 10}
        },
        "module": {"type": "string", "description": "Repo-relative path to the learning module that teaches this"},
        "references": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}
      }
    }
  }
}
