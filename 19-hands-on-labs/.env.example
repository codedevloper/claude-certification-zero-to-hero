# Copy to .env (git-ignored) or export these in your shell. Never commit real keys.
# mock = offline and free (default); live = real API calls that use credits
CLAUDE_LAB_MODE=mock
# Required only in live mode. Create a key at https://platform.claude.com/ (Console > API keys).
ANTHROPIC_API_KEY=your-api-key-here
# Optional model overrides
CLAUDE_LAB_MODEL=claude-opus-5-5
CLAUDE_LAB_FAST_MODEL=claude-haiku-5-5
